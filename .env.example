# Copie para .env e preencha. O .env nunca vai para o Git. Nenhum valor real fica neste arquivo.

# --- obrigatórias ---
# Banco PostgreSQL desta aplicação: postgresql://USUARIO:SENHA@HOST:5432/BANCO
ERV_BANCO=
# Chave que cifra nome e WhatsApp dos visitantes (32 bytes em base64). Gere com: python app/app.py chave
# Se perder esta chave, os contatos guardados não abrem mais. Guarde uma cópia fora do servidor.
ERV_CHAVE_DADOS=
# Endereços do site que podem mudar dados (separados por vírgula, sem barra no fim). Ex.: https://dominio.com.br,https://www.dominio.com.br
ERV_ORIGENS=

# --- opcionais (o valor mostrado é o padrão) ---
# 1 = site atrás de HTTPS (cookie Secure + HSTS). 0 só em teste local sem HTTPS.
ERV_HTTPS=1
# 1 = pede aos buscadores para não indexar (X-Robots-Tag). Troque para 0 quando o site for ao ar de verdade.
ERV_NOINDEX=1
# 1 = aceita também https://*.trycloudflare.com (só no compose.teste.yaml).
ERV_TUNEL_TESTE=0
# Cabeçalho com o IP real quando só o cloudflared fala com o app (ex.: CF-Connecting-IP). Vazio = IP da conexão.
ERV_IP_CABECALHO=
# Plano do site: basico (3 imóveis, 3 cidades), fasico (10 imóveis, 20 cidades) ou erivelto (sem limite).
ERV_PLANO=erivelto
# Versão do aviso de privacidade que o visitante aceita (a mesma do site/privacidade/index.html e do AVISO_VERSAO no site/ponte.js).
ERV_AVISO_VERSAO=v2
# Versão do termo que o corretor aceita no 1º acesso ao painel (a mesma do site/painel/termo.html). Mudou = o painel pede aceite de novo.
ERV_TERMO_VERSAO=v1
# Meses sem atividade até apagar um contato sozinho. 0 = não apaga (o aviso atual diz "até você pedir para apagar").
ERV_LEADS_MESES=0
# Lado maior, em px, da foto guardada (o painel envia até 2560).
ERV_FOTO_LADO=2560
# WhatsApp do site enquanto o corretor não salvar outro no painel (só números, com 55 e DDD). Vazio = sem número: o botão do site avisa e não abre conversa.
ERV_WHATSAPP=
# Pastas (no Docker já vêm certas): site estático e dados (fotos em ERV_DADOS/midia).
ERV_SITE=
ERV_DADOS=

# --- banco no Docker (usadas pelo serviço do Postgres e pelo backup.sh) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- backup (backup.sh) ---
# Chave PÚBLICA do age (age1...). A chave privada fica fora do servidor.
ERV_BACKUP_CHAVE=
# Pasta onde os backups ficam (14 dias).
ERV_BACKUP_DESTINO=
# Opcional: arquivo do compose e nome do serviço do banco (padrão: o compose da pasta e "banco").
ERV_BACKUP_COMPOSE=
ERV_BACKUP_SERVICO=banco
# Opcional: endereço do banco para usar o pg_dump desta máquina em vez do Docker.
ERV_BACKUP_BANCO_URL=
